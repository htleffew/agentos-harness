    "3": {
      "uid": 3,
      "key": [
        "Darius",
        "lord of Crossroads",
        "lord of the Crossroads"
      ],
      "keysecondary": [],
      "comment": "Lord Darius",
      "content": "Darius is a tall, lean southern lord with dark hair, green eyes and olive skin. At his table he serves lavish meals and wears silk and perfume. His pursuit of women is talked about at court. He came to Crossroads Keep as a ward and inherited it after the family there died without a blood heir. A few house guards serve him in the keep. Hired companies keep watch at the mines and on the Iron Road. Northern lords still do business with him. He keeps taxes steady, sells iron at prices they will pay and lets traffic use the road.",
      "constant": false,
      "vectorized": false,
      "selective": false,
      "selectiveLogic": 0,
