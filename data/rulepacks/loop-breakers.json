{
  "format": "undercurrent2-rules",
  "version": 1,
  "pack": {
    "id": "loop_breakers",
    "name": "Loop breakers",
    "description": "Every few turns, with a chance: change place or time, bring someone in, reveal something new, let a cost come due. Never during intimate scenes.",
    "default_enabled": true
  },
  "rules": [
    {
      "id": "lb_move_place",
      "name": "Change of place",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 7,
          "offset": 0
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 45
        }
      ],
      "cooldown": 6,
      "pick": "random",
      "pool": [
        "If the scene has sat in one spot for a while, move it: a reason to go somewhere else that grows out of what is already happening."
      ]
    },
    {
      "id": "lb_time_cut",
      "name": "Time cut",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 9,
          "offset": 3
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 40
        }
      ],
      "cooldown": 8,
      "pick": "random",
      "pool": [
        "Consider a time cut past dead time to the next moment that matters, leaving every choice that belongs to {{user}} intact."
      ]
    },
    {
      "id": "lb_arrival",
      "name": "Someone arrives",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 8,
          "offset": 5
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 40
        }
      ],
      "cooldown": 8,
      "pick": "random",
      "pool": [
        "Bring someone in: a person with their own agenda who arrives for a reason already set up in the story."
      ]
    },
    {
      "id": "lb_new_info",
      "name": "New information",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 6,
          "offset": 2
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 45
        }
      ],
      "cooldown": 6,
      "pick": "random",
      "pool": [
        "Reveal one new piece of information that changes what someone present wants or believes."
      ]
    },
    {
      "id": "lb_consequence",
      "name": "Consequence comes due",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 10,
          "offset": 4
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 50
        }
      ],
      "cooldown": 8,
      "pick": "random",
      "pool": [
        "Something done earlier comes due now: a cost, a reward, or a person who noticed."
      ]
    },
    {
      "id": "lb_irreversible",
      "name": "A decision that sticks",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 11,
          "offset": 6
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 40
        }
      ],
      "cooldown": 10,
      "pick": "random",
      "pool": [
        "Have {{random_npc}} make a decision this turn that cannot easily be undone."
      ]
    },
    {
      "id": "lb_deadline",
      "name": "Deadline",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 12,
          "offset": 7
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 35
        }
      ],
      "cooldown": 12,
      "pick": "random",
      "pool": [
        "Introduce time pressure: something must happen by a specific hour, and everyone present knows it."
      ]
    },
    {
      "id": "lb_reversal",
      "name": "Reversal",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 10,
          "offset": 8
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 35
        }
      ],
      "cooldown": 10,
      "pick": "random",
      "pool": [
        "Flip one expectation the recent replies set up, consistent with everything established."
      ]
    },
    {
      "id": "lb_want_shift",
      "name": "A want shifts",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 7,
          "offset": 4
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 40
        }
      ],
      "cooldown": 8,
      "pick": "random",
      "pool": [
        "{{random_present}}'s want ({{want:any}}) shifts or sharpens because of what just happened; let the plan change."
      ]
    },
    {
      "id": "lb_register",
      "name": "Break the register",
      "priority": 3,
      "logic": "all",
      "triggers": [
        {
          "type": "every_n",
          "n": 8,
          "offset": 1
        },
        {
          "type": "not_scene",
          "is": [
            "intimate"
          ]
        },
        {
          "type": "chance",
          "pct": 40
        }
      ],
      "cooldown": 8,
      "pick": "random",
      "pool": [
        "The emotional register has held for several turns; let {{random_present}}, now {{mood}}, break it with an unexpected reaction."
      ]
    }
  ]
}
