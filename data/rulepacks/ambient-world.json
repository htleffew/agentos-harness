{
  "format": "undercurrent2-rules",
  "version": 1,
  "pack": {
    "id": "ambient_world",
    "name": "Ambient world",
    "description": "Sensory and background life: weather, sound, light, passers-by. Quiet during intimate and grief scenes. Off by default because Events already rolls ambient pulses; turn it on for a busier world.",
    "default_enabled": false
  },
  "rules": [
    {
      "id": "aw_weather",
      "name": "Weather",
      "priority": 2,
      "logic": "all",
      "triggers": [
        {
          "type": "not_scene",
          "is": [
            "intimate",
            "grief"
          ]
        },
        {
          "type": "chance",
          "pct": 10
        }
      ],
      "cooldown": 6,
      "pick": "random",
      "pool": [
        "{{weather}} makes itself felt in {{place}}: one specific sensory detail with a visible effect on {{random_present}}."
      ]
    },
    {
      "id": "aw_sound",
      "name": "A sound",
      "priority": 2,
