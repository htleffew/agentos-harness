{
  "format": "undercurrent-rules",
  "version": 1,
  "pack": {
    "id": "desire_impulses",
    "name": "Desire impulses",
    "description": "Chance-based impulses drawn from each present character's own intimacy profile (likes only; limits are never used). Runs only when attraction is live or the scene is romantic/intimate.",
    "default_enabled": true
