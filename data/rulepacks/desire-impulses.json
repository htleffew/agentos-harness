  "rules": [
    {
      "id": "di_body_first",
      "name": "Impulse shows in the body",
      "priority": 4,
      "logic": "all",
      "triggers": [
        {
          "type": "any_of",
          "triggers": [
            {
              "type": "attraction",
              "who": "any"
            },
            {
              "type": "scene_mode",
              "modes": [
                "@romance"
              ]
            }
          ]
        },
        {
          "type": "not_scene_mode",
          "modes": [
            "@grief"
          ]
        },
        {
          "type": "chance",
          "pct": 18
        }
      ],
      "cooldown": 4,
      "action": {
        "type": "inject",
        "pool": [
          "{{random_present}} lets an impulse toward {{pref:any}} show in the body first: a held glance, a shift closer, a breath caught.",
          "Something in the moment brushes against {{random_present}}'s taste for {{pref:any}}; it shows in one unguarded physical detail.",
          "{{random_present}} is thinking about {{pref:any}} and it leaks out in posture, hands or voice before any words do."
        ],
        "pick": "random",
        "placement": "note"
      }
    },
