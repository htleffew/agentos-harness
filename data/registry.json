{
  "_doc": "Shared ids between the preset (setvar uc_persona_id / uc_tone_id / uc_genre_id / uc_voice_id) and the extension (director flavor + event biases). event_bias multiplies base event chances: pulse=ambient life, twist=complication/reversal, curiosity=a mystery thread or question planted. beat_favor lists beat types the director prefers.",
  "personas": [
    {
      "id": "none",
      "name": "Invisible author",
      "sensibility": "No persona. A neutral, exacting novelist.",
      "ooc": "Plain, brief, factual.",
